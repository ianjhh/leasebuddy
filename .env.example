# --- Database Settings ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leasebuddy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leasebuddy

# --- Redis Settings ---
REDIS_URL=redis://localhost:6379/0

# --- AI Models ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# --- Backend API ---
API_SECRET_KEY=change-me-to-a-real-secret
ENVIRONMENT=development

# --- AWS Settings (deployed resources) ---
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name-here
STEP_FUNCTION_ARN=arn:aws:states:us-east-1:YOUR_ACCOUNT_ID:stateMachine:LeaseBuddyPipeline
